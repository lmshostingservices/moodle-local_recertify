<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/recertify/db" VERSION="20261012" COMMENT="XMLDB file for local_recertify"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_recertify_schedule" COMMENT="Per-course recertification schedule configuration">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="scheduletype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="relative" SEQUENCE="false"/>
        <FIELD NAME="intervalmonths" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="12" SEQUENCE="false"/>
        <FIELD NAME="fixeddate" TYPE="char" LENGTH="5" NOTNULL="false" SEQUENCE="false" COMMENT="MM-DD for fixed schedule"/>
        <FIELD NAME="warningdays" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="14" SEQUENCE="false"/>
        <FIELD NAME="resetdepth" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="completion" SEQUENCE="false"/>
        <FIELD NAME="activityscope" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="all" SEQUENCE="false" COMMENT="all, or selected to limit the reset to the activities listed in local_recertify_schedule_cm"/>
        <FIELD NAME="wipeassignments" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="wipequizattempts" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="wipescormtracks" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="notifyonreset" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_course" UNIQUE="true" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_recertify_log" COMMENT="Audit log of all recertification resets and warnings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="scheduleid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="reset" SEQUENCE="false" COMMENT="reset or warned"/>
        <FIELD NAME="depth" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="triggertype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="scheduled" SEQUENCE="false" COMMENT="scheduled or manual"/>
        <FIELD NAME="resettime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Cycle boundary this row belongs to, used for idempotency"/>
        <FIELD NAME="completiontime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The learner course completion date captured immediately before it was cleared, 0 if they had none"/>
        <FIELD NAME="finalgrade" TYPE="number" LENGTH="10" NOTNULL="false" SEQUENCE="false" DECIMALS="5" COMMENT="The learner course final grade captured immediately before it was cleared"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_course" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="idx_cycle" UNIQUE="false" FIELDS="userid, courseid, action, resettime"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_recertify_schedule_cm" COMMENT="Activities a schedule is limited to when activityscope is selected">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="scheduleid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="course_modules.id of a selected activity"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_schedule" TYPE="foreign" FIELDS="scheduleid" REFTABLE="local_recertify_schedule" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_schedule_cm" UNIQUE="true" FIELDS="scheduleid, cmid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
